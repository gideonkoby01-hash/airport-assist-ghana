/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Report-only for now: the browser reports anything this policy would block without blocking it. After a week of
  # normal use with no reports in the browser console, rename this header to Content-Security-Policy to enforce it.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://images.unsplash.com https://static.wixstatic.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Vite fingerprints everything in /assets, so it can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed file names: cache for a day so a replaced logo shows up quickly
/images/*
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=86400
