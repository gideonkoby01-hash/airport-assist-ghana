{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_booking_management_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyManagementBooking",
            "args": {
              "booking_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify management",
            "description": "Create in-app notifications for management users"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Booking"
    }
  },
  "name": "New Booking Management Notify",
  "description": "Creates in-app notifications for all Management users when a new booking is created."
}