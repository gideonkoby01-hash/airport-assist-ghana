{
  "name": "Payment",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "booking_reference": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Amount collected in this payment, in GHS."
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "mobile_money",
        "card",
        "corporate_account"
      ]
    },
    "balance_after": {
      "type": "number",
      "description": "Outstanding balance on the booking immediately after this payment."
    },
    "recorded_by_id": {
      "type": "string"
    },
    "recorded_by_name": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string"
    }
  },
  "required": [
    "booking_id",
    "amount",
    "method",
    "recorded_by_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "data.recorded_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
