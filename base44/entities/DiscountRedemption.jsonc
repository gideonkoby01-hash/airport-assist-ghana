{
  "name": "DiscountRedemption",
  "type": "object",
  "properties": {
    "discount_code_id": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Snapshot of the code at redemption time."
    },
    "booking_id": {
      "type": "string"
    },
    "booking_reference": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Passenger account that redeemed the code."
    },
    "user_email": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "individual",
        "corporation"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "recipient_name": {
      "type": "string",
      "description": "Individual or corporation the code was issued to, snapshotted at redemption."
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "enumColors": [
        "green",
        "yellow"
      ]
    },
    "discount_value": {
      "type": "number",
      "description": "Snapshotted percentage or fixed value, unaffected by later code edits."
    },
    "discount_amount": {
      "type": "number",
      "description": "Actual GHS discount granted on this booking."
    },
    "gross_total": {
      "type": "number",
      "description": "Booking total before the discount."
    },
    "net_total": {
      "type": "number",
      "description": "Booking total after the discount (what the passenger owes)."
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "discount_code_id",
    "code",
    "booking_id",
    "discount_amount",
    "gross_total",
    "net_total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}