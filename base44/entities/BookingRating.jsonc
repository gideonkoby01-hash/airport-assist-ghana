{
  "name": "BookingRating",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "The completed booking this review belongs to. One rating per booking."
    },
    "booking_reference": {
      "type": "string",
      "description": "Snapshot of the booking reference at review time."
    },
    "passenger_user_id": {
      "type": "string",
      "description": "The passenger account that submitted the review."
    },
    "passenger_name": {
      "type": "string",
      "description": "Snapshot of the passenger name at review time."
    },
    "overall_rating": {
      "type": "number",
      "description": "Overall Airport Assist experience, an integer from 1 (Poor) to 5 (Excellent)."
    },
    "feedback": {
      "type": "string",
      "description": "Optional written feedback. May mention the assigned supervisor, staff professionalism, communication, punctuality and service quality."
    },
    "supervisor_user_id": {
      "type": "string",
      "description": "Supervisor user id snapshotted from the booking at review time, never re-derived from a current profile."
    },
    "supervisor_name": {
      "type": "string",
      "description": "Supervisor name snapshotted from the booking at review time."
    },
    "package_code": {
      "type": "string",
      "enum": [
        "full_arrival",
        "full_departure",
        "departure_priority",
        "porter_only"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "gray"
      ],
      "description": "Service package snapshot."
    },
    "package_name": {
      "type": "string",
      "description": "Service package name snapshot."
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "The booking / service date (flight date) the review refers to."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the passenger submitted the review."
    }
  },
  "required": [
    "booking_id",
    "booking_reference",
    "passenger_user_id",
    "overall_rating",
    "submitted_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.passenger_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}