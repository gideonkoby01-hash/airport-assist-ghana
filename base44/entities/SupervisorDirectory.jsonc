{
  "name": "SupervisorDirectory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "phone": {
      "type": "string",
      "description": "Contact / telephone number shown to the passenger once this supervisor is assigned."
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number shown to the passenger once this supervisor is assigned."
    },
    "languages": {
      "type": "string",
      "description": "Languages spoken, as a comma-separated list (e.g. English, Twi, French)."
    },
    "bio": {
      "type": "string",
      "description": "Short professional introduction or biography."
    },
    "photo_uri": {
      "type": "string",
      "description": "Private file URI of the supervisor's profile photograph. Access is governed by this entity's RLS and the booking-scoped profile function."
    }
  },
  "required": [
    "user_id",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}