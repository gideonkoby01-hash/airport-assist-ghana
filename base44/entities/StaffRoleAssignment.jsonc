{
  "name": "StaffRoleAssignment",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "The invitee email address. Matched against the logged-in user's email to apply the pending role."
    },
    "role": {
      "type": "string",
      "enum": [
        "passenger",
        "supervisor",
        "management",
        "admin"
      ],
      "description": "The app-specific role to assign once the invited user logs in."
    }
  },
  "required": [
    "email",
    "role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}