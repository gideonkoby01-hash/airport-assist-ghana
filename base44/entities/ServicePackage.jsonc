{
  "name": "ServicePackage",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "full_arrival",
        "full_departure",
        "departure_priority",
        "porter_only"
      ]
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "flight_type": {
      "type": "string",
      "enum": [
        "arrival",
        "departure",
        "both"
      ]
    },
    "includes_lounge": {
      "type": "boolean"
    },
    "inclusions": {
      "type": "string"
    },
    "exclusions": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}