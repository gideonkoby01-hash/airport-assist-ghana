{
  "name": "EmailDelivery",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string",
      "description": "Unique event identifier used for duplicate prevention, e.g. booking_confirmation:<booking_id> or staff_request_decision:<request_id>:<action>."
    },
    "template_name": {
      "type": "string",
      "description": "The email template that was (or was attempted to be) sent."
    },
    "recipient_user_id": {
      "type": "string",
      "description": "The registered user the email was addressed to. Email addresses are deliberately not stored here."
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "failed",
        "skipped"
      ],
      "description": "queued = a send attempt is starting (claimed the event); sent = accepted by the email provider (delivery not individually confirmed); failed = the send was rejected or errored; skipped = no valid recipient."
    },
    "details": {
      "type": "string",
      "description": "Outcome details or failure reason. No secrets or full email addresses."
    },
    "related_entity_id": {
      "type": "string",
      "description": "The booking or account request the email relates to."
    }
  },
  "required": [
    "event_key",
    "template_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}