{
  "name": "Booking",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "package_code": {
      "type": "string",
      "enum": [
        "full_arrival",
        "full_departure",
        "departure_priority",
        "porter_only"
      ]
    },
    "package_name": {
      "type": "string"
    },
    "price_per_passenger": {
      "type": "number"
    },
    "num_passengers": {
      "type": "number"
    },
    "original_total": {
      "type": "number",
      "description": "Booking total before any discount. Equals total_value when no discount was applied."
    },
    "total_value": {
      "type": "number",
      "description": "Booking total actually owed by the passenger (after any discount). Outstanding balance and payments are measured against this value."
    },
    "discount_code_id": {
      "type": "string"
    },
    "discount_code": {
      "type": "string",
      "description": "Snapshot of the applied promo code, kept unchanged even if the code is later edited or deactivated."
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ]
    },
    "discount_value": {
      "type": "number",
      "description": "Snapshot of the percentage or fixed GHS value at the time of booking."
    },
    "discount_amount": {
      "type": "number",
      "description": "Actual GHS discount granted on this booking."
    },
    "discount_recipient_type": {
      "type": "string",
      "enum": [
        "individual",
        "corporation"
      ]
    },
    "discount_recipient_name": {
      "type": "string",
      "description": "Individual or corporation the discount was issued to, snapshotted at booking time."
    },
    "discount_redeemed_at": {
      "type": "string",
      "format": "date-time"
    },
    "flight_type": {
      "type": "string",
      "enum": [
        "arrival",
        "departure"
      ]
    },
    "airline": {
      "type": "string"
    },
    "flight_number": {
      "type": "string"
    },
    "flight_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_flight_time": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "total_bags": {
      "type": "number"
    },
    "special_requests": {
      "type": "string"
    },
    "lounge_used": {
      "type": "string"
    },
    "passenger_photo_uri": {
      "type": "string",
      "description": "Private file URI of the passenger's identification photo. Access is governed by the booking RLS."
    },
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "total_bags": {
            "type": "number"
          },
          "special_requests": {
            "type": "string"
          }
        }
      }
    },
    "porters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "porter_name": {
            "type": "string"
          },
          "passengers_handled": {
            "type": "number"
          },
          "commission": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "assigned",
        "in_progress",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "confirmed"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "partially_paid",
        "unpaid"
      ],
      "default": "unpaid"
    },
    "amount_collected": {
      "type": "number",
      "default": 0
    },
    "outstanding_balance": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "mobile_money",
        "card",
        "corporate_account"
      ]
    },
    "assigned_supervisor_id": {
      "type": "string"
    },
    "assigned_supervisor_name": {
      "type": "string"
    },
    "booking_channel": {
      "type": "string",
      "enum": [
        "online",
        "walk_in"
      ]
    }
  },
  "required": [
    "reference",
    "package_code",
    "flight_type",
    "num_passengers",
    "total_value",
    "status",
    "payment_status",
    "booking_channel"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_supervisor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "passenger"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_supervisor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}