{
  "name": "ShiftReport",
  "type": "object",
  "properties": {
    "supervisor_id": {
      "type": "string"
    },
    "supervisor_name": {
      "type": "string"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "morning",
        "night"
      ]
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "shift_start": {
      "type": "string"
    },
    "shift_end": {
      "type": "string"
    },
    "booking_count": {
      "type": "number"
    },
    "total_passengers": {
      "type": "number"
    },
    "service_breakdown": {
      "type": "string"
    },
    "total_revenue": {
      "type": "number"
    },
    "total_collected": {
      "type": "number"
    },
    "total_outstanding": {
      "type": "number"
    },
    "lounges_used": {
      "type": "string"
    },
    "porter_count": {
      "type": "number"
    },
    "total_commission": {
      "type": "number"
    },
    "cancellations": {
      "type": "number"
    },
    "no_shows": {
      "type": "number"
    },
    "completed": {
      "type": "number"
    },
    "remarks": {
      "type": "string"
    },
    "booking_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reporting_period_start": {
      "type": "string",
      "format": "date"
    },
    "reporting_period_end": {
      "type": "string",
      "format": "date"
    },
    "meet_assist_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_type": {
            "type": "string",
            "enum": [
              "departure_only",
              "full_departure",
              "arrival"
            ]
          },
          "amount_paid": {
            "type": "number"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "pos",
              "cash",
              "momo"
            ]
          }
        }
      }
    },
    "porter_total_bookings": {
      "type": "number"
    },
    "porter_amount_paid": {
      "type": "number"
    },
    "porter_payment_method": {
      "type": "string",
      "enum": [
        "pos",
        "cash",
        "momo"
      ]
    },
    "porter_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "porter_id": {
            "type": "string"
          },
          "porter_name": {
            "type": "string"
          },
          "passengers_handled": {
            "type": "number"
          },
          "commission": {
            "type": "number"
          }
        }
      }
    },
    "meet_assist_total_paid": {
      "type": "number"
    },
    "porter_total_passengers": {
      "type": "number"
    },
    "porter_total_commission": {
      "type": "number"
    },
    "grand_total_paid": {
      "type": "number"
    }
  },
  "required": [
    "supervisor_id",
    "reporting_period_start",
    "shift_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "management"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}